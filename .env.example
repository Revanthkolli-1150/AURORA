# ==============================================================================
# AURORA RELIABILITY PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Ingress & Ports
GATEWAY_PORT=8080
CONSOLE_PORT=3000
IDENTITY_SERVICE_PORT=8081
INCIDENT_SERVICE_PORT=8082
TELEMETRY_SERVICE_PORT=8083
POLICY_SERVICE_PORT=8084
RECOVERY_SERVICE_PORT=8085

# Intelligence Engines Ports
ANOMALY_ENGINE_PORT=9001
PREDICTION_ENGINE_PORT=9002
RCA_ENGINE_PORT=9003
AI_ENGINE_PORT=9004

# Database & Storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aurora_reliability
POSTGRES_USER=aurora_admin
POSTGRES_PASSWORD=change_this_in_production
REDIS_URL=redis://localhost:6379

# Observability Stack Endpoints
OTEL_COLLECTOR_URL=http://localhost:4318
PROMETHEUS_URL=http://localhost:9090
GRAFANA_PORT=3001
LOKI_URL=http://localhost:3100

# Security & Secrets
JWT_SECRET=super_secret_aurora_jwt_signing_key_replace_me
INTERNAL_SERVICE_KEY=internal_mesh_authentication_key

# AI Copilot & LLM Integrations
AI_ENGINE_MODEL_PROVIDER=openai
AI_ENGINE_API_KEY=your_api_key_here
AI_ENGINE_MODEL_NAME=gpt-4o
