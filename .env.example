# ==============================================================================
# AURORA RELIABILITY PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
# cp .env.example .env
# Never commit .env to version control!

# Server Configuration
SERVER_PORT=8080
AURORA_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aurora
DB_USERNAME=aurora
DB_PASSWORD=your_secure_database_password_here

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
